RewriteEngine On

# Força HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove o www, mantendo o domínio raiz como canônico
RewriteCond %{HTTP_HOST} ^www\.conectusambiental\.com\.br$ [NC]
RewriteRule ^ https://conectusambiental.com.br%{REQUEST_URI} [L,R=301]

# Remove "index.html" da URL
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^index\.html$ / [L,R=301]
